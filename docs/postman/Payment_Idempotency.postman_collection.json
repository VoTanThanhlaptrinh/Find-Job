  "item": [
    {
      "name": "TC-00: Auth Login (Lấy JWT Access Token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-00: Đăng nhập thành công (200 OK)', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('TC-00: Response chứa JWT accessToken trong trường data', function () {",
              "    pm.expect(json).to.have.property('data');",
              "    pm.expect(json.data).to.be.a('string').and.not.be.empty;",
              "    pm.collectionVariables.set('accessToken', json.data);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/user/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "user",
            "login"
          ]
        },
        "description": "Đăng nhập tài khoản user (hoặc sửa path thành /api/auth/hirer/login nếu dùng tài khoản hirer) để lưu JWT vào biến collection `accessToken`."
      }
    },
    {
      "name": "TC-01: Thiếu header Idempotency-Key (400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-01: Trả về 400 Bad Request khi thiếu Idempotency-Key', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('TC-01: ApiResponse báo lỗi thiếu header Idempotency-Key', function () {",
              "    pm.expect(json.status).to.eql(400);",
              "    pm.expect(json.message).to.include('Idempotency-Key');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
