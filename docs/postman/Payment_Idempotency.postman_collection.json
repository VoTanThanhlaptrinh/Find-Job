      "name": "TC-05: Gửi lại cùng Idempotency-Key & cùng Body (201 Created, Replay từ Redis)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-05: Replay vẫn trả về 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('TC-05: Header X-Idempotent-Replayed phải là true', function () {",
              "    pm.response.to.have.header('X-Idempotent-Replayed');",
              "    pm.expect(pm.response.headers.get('X-Idempotent-Replayed')).to.eql('true');",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('TC-05: Trả về chính xác id và transactionCode của lần 1 (không tạo bản ghi mới)', function () {",
              "    pm.expect(String(json.data.id)).to.eql(pm.collectionVariables.get('firstPaymentId'));",
              "    pm.expect(json.data.transactionCode).to.eql(pm.collectionVariables.get('firstTransactionCode'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
