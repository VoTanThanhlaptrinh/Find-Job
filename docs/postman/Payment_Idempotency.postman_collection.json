    {
      "name": "TC-04: Tạo Payment hợp lệ lần 1 (201 Created, X-Idempotent-Replayed: false)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const newKey = pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('activeIdempotencyKey', newKey);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('TC-04: Lần gọi đầu tạo Payment thành công (201 Created)', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('TC-04: Header X-Idempotent-Replayed phải là false', function () {",
              "    pm.response.to.have.header('X-Idempotent-Replayed');",
              "    pm.expect(pm.response.headers.get('X-Idempotent-Replayed')).to.eql('false');",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('TC-04: Lưu lại paymentId và transactionCode để đối chiếu khi replay', function () {",
              "    pm.expect(json.data).to.be.an('object');",
              "    pm.expect(json.data.id).to.be.a('number');",
              "    pm.expect(json.data.transactionCode).to.match(/^PAY-/);",
              "    pm.expect(json.data.status).to.eql('COMPLETED');",
              "    pm.collectionVariables.set('firstPaymentId', String(json.data.id));",
              "    pm.collectionVariables.set('firstTransactionCode', json.data.transactionCode);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{activeIdempotencyKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 499000.00,\n  \"currency\": \"VND\",\n  \"paymentMethod\": \"MOMO\",\n  \"description\": \"Goi Pro 1 thang\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments"
          ]
        }
      }
    },
