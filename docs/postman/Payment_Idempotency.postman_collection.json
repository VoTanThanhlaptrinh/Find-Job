        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 499000.00,\n  \"currency\": \"VND\",\n  \"paymentMethod\": \"VNPAY\",\n  \"description\": \"Test missing Idempotency-Key header\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments"
          ]
