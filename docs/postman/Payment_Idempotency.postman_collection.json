              "    pm.response.to.have.status(400);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('TC-03: Thông báo giới hạn 128 ký tự', function () {",
              "    pm.expect(json.status).to.eql(400);",
              "    pm.expect(json.message).to.include('128');",
              "});"
            ]
          }
        }
